/* ===================== GLOBAL ===================== */
QWidget {
    font-family: "Segoe UI";
    color: #E6F1FF;
    font-size: 13px;
}

#CentralBg {
    /* Transparent : laisse voir l'image de fond dessinée par MainWindow::paintEvent.
       Une couleur opaque ici recouvrirait complètement le fond derrière la sidebar,
       la top bar et les cartes (qui, elles, utilisent des rgba semi-transparents). */
    background-color: transparent;
}

/* ===================== SIDEBAR ===================== */
#Sidebar {
    background-color: rgba(4, 12, 26, 110);
    border-right: 1px solid rgba(18, 58, 94, 180);
}

#LogoTitle {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
}

#LogoSubtitle {
    font-size: 10px;
    color: #6FA8DC;
}

QPushButton#NavButton {
    text-align: left;
    padding: 9px 12px;
    border: none;
    border-radius: 10px;
    background-color: transparent;
    color: #B9D3EC;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background-color: rgba(0, 136, 255, 60);
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: #0088FF;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#LogoutButton {
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #FF8A80;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#LogoutButton:hover {
    background-color: rgba(229, 57, 53, 60);
    color: #FFFFFF;
}

/* ===================== TOP BAR ===================== */
#TopBar {
    background-color: rgba(8, 20, 40, 210);
    border-bottom: 1px solid #123a5e;
}

#StatsButton, #ReportButton {
    background-color: #0d2745;
    border: 1px solid #1E88E5;
    border-radius: 8px;
    padding: 8px 16px;
    color: #FFFFFF;
    font-weight: bold;
}

#StatsButton:hover, #ReportButton:hover {
    background-color: #123a63;
}

#DateChip, #UserChip {
    background-color: #0d2745;
    border: 1px solid #123a5e;
    border-radius: 8px;
    padding: 6px 14px;
    color: #CFE6FF;
}

/* ===================== CARDS ===================== */
QFrame.Card {
    background-color: rgba(9, 24, 46, 220);
    border: 1px solid #16406b;
    border-radius: 12px;
}

QLabel.CardValue {
    font-size: 22px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel.CardLabel {
    font-size: 12px;
    color: #9FC4EA;
}

QLabel.SectionTitle {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel.SectionSubtitle {
    font-size: 12px;
    color: #7FA8D0;
}

/* ===================== INPUTS ===================== */
QLineEdit, QComboBox {
    background-color: #08203a;
    border: 1px solid #1a4b78;
    border-radius: 8px;
    padding: 7px 10px;
    color: #E6F1FF;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #1E88E5;
}
QComboBox::drop-down { border: none; width: 24px; }

QPushButton#PrimaryButton {
    background-color: #007AFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12.5px;
}
QPushButton#PrimaryButton:hover { background-color: #3395FF; }

QPushButton#DangerButton {
    background-color: #EA3943;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12.5px;
}
QPushButton#DangerButton:hover { background-color: #FF5B65; }

QPushButton#IconEditButton, QPushButton#IconDeleteButton {
    border: none;
    border-radius: 12px;
    padding: 0px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}
QPushButton#IconEditButton { background-color: #007AFF; }
QPushButton#IconEditButton:hover { background-color: #3395FF; }

QPushButton#IconDeleteButton { background-color: #FF3B30; }
QPushButton#IconDeleteButton:hover { background-color: #FF6259; }

/* ===================== TABLE ===================== */
QTableWidget#StockTable {
    background-color: rgba(7, 19, 37, 200);
    alternate-background-color: rgba(12, 30, 55, 200);
    gridline-color: #123a5e;
    border: 1px solid #16406b;
    border-radius: 10px;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
    font-size: 10px;
}
QTableWidget#StockTable QHeaderView::section {
    background-color: #0a1f3c;
    color: #9FC4EA;
    padding: 4px 4px;
    border: none;
    border-bottom: 1px solid #16406b;
    font-weight: bold;
    font-size: 9.5px;
}
QTableWidget#StockTable::item { padding: 1px 4px; }

/* ===================== BADGES ===================== */
/* Badges "normaux" : utilisés dans le panneau de détail (plus grands) */
QLabel.BadgeBlue   { background-color: #007AFF; color: white; border-radius: 8px; padding: 3px 10px; font-weight: bold; font-size: 11px; }
QLabel.BadgeGreen  { background-color: #00A86B; color: white; border-radius: 8px; padding: 3px 10px; font-weight: bold; font-size: 11px; }
QLabel.BadgeOrange { background-color: #D97706; color: white; border-radius: 8px; padding: 3px 10px; font-weight: bold; font-size: 11px; }
QLabel.BadgeRed    { background-color: #FF3B30; color: white; border-radius: 8px; padding: 3px 10px; font-weight: bold; font-size: 11px; }

/* Badges compacts : utilisés dans les cellules du tableau */
QLabel.BadgeBlueSm   { background-color: #007AFF; color: white; border-radius: 6px; padding: 3px 8px; font-weight: bold; font-size: 10px; }
QLabel.BadgeGreenSm  { background-color: #00A86B; color: white; border-radius: 6px; padding: 3px 8px; font-weight: bold; font-size: 10px; }
QLabel.BadgeOrangeSm { background-color: #D97706; color: white; border-radius: 6px; padding: 3px 8px; font-weight: bold; font-size: 10px; }
QLabel.BadgeRedSm    { background-color: #FF3B30; color: white; border-radius: 6px; padding: 3px 8px; font-weight: bold; font-size: 10px; }

/* ===================== TABS (Details panel) ===================== */
QTabWidget::pane {
    border: 1px solid #16406b;
    border-radius: 10px;
    background-color: rgba(9, 24, 46, 220);
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #9FC4EA;
    padding: 4px 6px;
    margin-right: 2px;
    border: none;
    font-weight: bold;
    font-size: 10px;
}
QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #1E88E5;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #1a4b78;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #1E88E5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
